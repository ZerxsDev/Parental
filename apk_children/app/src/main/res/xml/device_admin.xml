<?xml version="1.0" encoding="utf-8"?>
<!-- Kebijakan Device Admin: lock layar + kekuatan password.
     TIDAK memakai force-add/limits per-app launcher karena sesuai alur:
     semua izin diminta KECUALI launcher -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <watch-login />
        <limit-password />
        <reset-password />
    </uses-policies>
</device-admin>
