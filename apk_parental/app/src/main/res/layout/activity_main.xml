<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel Parental (Anak)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0D47A1" />

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="#455A64" />

        <!-- KARTU: KUNCI LAYAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Kunci Layar Anak"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/swLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kunci layar AKTIF (ON/OFF)"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnActiveAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aktifkan Device Admin (sekali saja)"
                android:visibility="gone" />
        </LinearLayout>

        <!-- KARTU: BLOKIR APLIKASI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚫 Blokir Aplikasi"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/swBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemblokiran aplikasi AKTIF (ON/OFF)"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvBlockedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diblokir: 0 aplikasi"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnPickApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pilih Aplikasi Yang Diblokir" />
        </LinearLayout>

        <!-- KARTU: PASSWORD HTML -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Password HTML"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ganti Password Panel Ini" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
